# ---- App ----
NODE_ENV=development
PORT=4000
API_PREFIX=v1
# Comma-separated list of allowed CORS origins (the Next.js frontend origin(s))
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://sos:sos@localhost:5432/sos?schema=public

# ---- JWT ----
# Use long random strings in production, e.g. `openssl rand -hex 64`
# The frontend contract (docs/API.md §1.7) suggests a 7-day access token and does not
# yet call a refresh endpoint, so the access token's lifetime IS the effective session
# length for the current frontend. Refresh-token rotation below is implemented and
# available at POST /auth/refresh for when the frontend adopts short-lived access tokens
# (see ARCHITECTURE.md §5 "Recommended hardening"); until then, keep this long.
JWT_ACCESS_SECRET=dev-access-secret-change-me-dev-access-secret-change-me
JWT_ACCESS_TTL=7d
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d
REFRESH_COOKIE_NAME=sos_rt
# Set to your API's registrable domain in production (e.g. api.senseofstone.com); leave empty for localhost
COOKIE_DOMAIN=
# Set to "true" once the API is served over HTTPS
COOKIE_SECURE=false

# ---- Google Sign-In ----
# OAuth 2.0 Client ID (Web) from Google Cloud Console, same value the frontend
# uses for NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ---- Object storage (S3-compatible: MinIO locally, Cloudflare R2 / AWS S3 in production) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sos-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO and most S3-compatible providers need path-style addressing; AWS S3 itself does not.
S3_FORCE_PATH_STYLE=true
# Public base URL images are served from (CDN domain, MinIO public endpoint, or R2 public bucket URL).
# Resulting image URL = `${S3_PUBLIC_BASE_URL}/${objectKey}`
S3_PUBLIC_BASE_URL=http://localhost:9000/sos-uploads

UPLOAD_MAX_SIZE_MB=5

# ---- Rate limiting ----
# Global default applied to every route. Auth endpoints (login/register) and POST /contact
# use a stricter, hardcoded 5-requests/60s limit via @Throttle() (docs/API.md §1.6 RATE_LIMITED).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20

# ---- Logging ----
LOG_LEVEL=info

# ---- Seed data (used only by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@senseofstone.com
SEED_ADMIN_PASSWORD=admin1234
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=customer1234
