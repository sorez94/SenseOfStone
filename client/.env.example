# "mock" = use the built-in fake backend (src/mocks) served at /api/v1.
# "http" = call a real backend at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the real backend (only used when NEXT_PUBLIC_API_MODE=http), e.g. https://api.senseofstone.com/v1
NEXT_PUBLIC_API_BASE_URL=

# Google Identity Services client ID. When empty, a mock Google account chooser is shown instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Comma separated list of remote image hosts served by the real backend/CDN.
NEXT_PUBLIC_IMAGE_HOSTS=

# Public origin of this site, used for absolute URLs in metadata (Open Graph etc.).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
