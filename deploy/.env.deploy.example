# Copy to deploy/.env.deploy and fill in. Used only by deploy/deploy.sh (never sent to the
# remote server itself - it just tells the script where/how to connect).
REMOTE_USER=root
REMOTE_HOST=203.0.113.10
REMOTE_DIR=/opt/sos
# Optional: path to a specific SSH private key (passed to ssh/rsync as -i / -e "ssh -i ...")
SSH_KEY=
