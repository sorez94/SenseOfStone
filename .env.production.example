# Single env file for `docker-compose.prod.yml`. Copy to `.env` in this same directory
# (next to docker-compose.prod.yml) and fill in real values before deploying.
#
#   cp .env.production.example .env

# ==== Deployment (managed by deploy/remote-deploy.sh - do not edit by hand on the server) ====
# Exact image tag currently deployed; remote-deploy.sh rewrites this to the new commit SHA
# on every deploy (and back to the previous value on a failed health check / rollback).
IMAGE_TAG=latest

# ==== Postgres ====
POSTGRES_USER=sos
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sos

# ==== MinIO (self-hosted S3-compatible object storage) ====
# For a managed alternative (Cloudflare R2 / AWS S3), skip the `minio`/`minio-init`
# services in docker-compose.prod.yml entirely and point S3_* below at that provider.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password
# Public URL product images are served from. With self-hosted MinIO this is the server's
# public IP/domain on port 9000 (see the `minio` service's port mapping below).
S3_PUBLIC_BASE_URL=http://YOUR_SERVER_IP:9000/sos-uploads

# ==== Backend (NestJS API) ====
API_PREFIX=v1
# Comma-separated list — must include the exact origin the browser loads the frontend from.
CORS_ORIGINS=http://YOUR_SERVER_IP
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-64
JWT_ACCESS_TTL=7d
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-64
JWT_REFRESH_TTL=30d
REFRESH_COOKIE_NAME=sos_rt
COOKIE_DOMAIN=
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
UPLOAD_MAX_SIZE_MB=5
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@senseofstone.com
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=change-me-strong-password
# Set to "true" for exactly the first deploy to populate demo categories/products; leave
# "false" afterwards so redeploys don't re-run the seed against live data.
RUN_SEED=false

# ==== Frontend (Next.js) build args — baked into the JS bundle at build time ====
NEXT_PUBLIC_API_MODE=http
# Must match CORS_ORIGINS's server-reachable counterpart: http://YOUR_SERVER_IP:4000/v1
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:4000/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_IMAGE_HOSTS=YOUR_SERVER_IP
NEXT_PUBLIC_SITE_URL=http://YOUR_SERVER_IP
